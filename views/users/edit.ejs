<% include('../layouts/header.ejs') %>

<style>
  body {
    background-color: #0f172a;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #e0e7ff;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
  }

  form {
    background: linear-gradient(145deg, #1e1b4b, #111827);
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    width: 400px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  input[type="text"],
  input[type="file"],
  input[type="hidden"] {
    background-color: #1e293b;
    color: #e0e7ff;
    border: 1px solid #312e81;
    border-radius: 8px;
    padding: 0.6rem;
    outline: none;
    width: 100%;
  }

  input[type="submit"] {
    background-color: #7c3aed;
    color: white;
    padding: 0.7rem;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s, transform 0.2s;
  }

  input[type="submit"]:hover {
    background-color: #facc15;
    color: #1e1b4b;
    transform: scale(1.05);
  }

  img {
    border-radius: 50%;
    border: 3px solid #a78bfa;
    margin-top: 1rem;
    box-shadow: 0 0 15px rgba(167, 139, 250, 0.5);
  }

  a {
    margin-top: 1rem;
    text-align: center;
    text-decoration: none;
    color: #7dd3fc;
    transition: color 0.3s;
  }

  a:hover {
    color: #facc15;
  }

  p {
    font-size: 0.9rem;
    color: #cbd5e1;
  }
</style>

<img src="userImages/<%= user.image %>" width="100px" height="100px" alt="userImages/<%= user.image %>">

<form action="" method="post" enctype="multipart/form-data">
  <input type="file" name="image">
  <input type="hidden" name="user_id" value="<%= user._id %>">
  
  <input type="text" name="name" value="<%= user.name %>" placeholder="Enter Name">
  
  <p>Email and Mobile once Entered cannot be changed</p>

  <input type="submit" value="Update Profile">

  <a href="/home">Home</a>
</form>

<% include('../layouts/footer.ejs') %>
