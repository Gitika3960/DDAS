<% include("../layouts/header.ejs") %>

<style>
  body {
    font-family: 'Segoe UI', sans-serif;
    background-color: #0f172a;
    color: #e2e8f0;
    margin: 0;
    padding: 0;
  }

  .container {
    max-width: 960px;
    margin: 50px auto;
    padding: 20px;
    background-color: #1e293b;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.4);
  }

  h1 {
    color: #facc15;
    text-align: center;
  }

  h2 {
    color: #38bdf8;
  }

  a {
    color: #10b981;
    text-decoration: none;
    font-weight: bold;
  }

  a:hover {
    text-decoration: underline;
  }

  table {
    width: 100%;
    margin-top: 20px;
    border-collapse: collapse;
    color: #f1f5f9;
  }

  td, th {
    padding: 12px;
    border-bottom: 1px solid #334155;
    text-align: left;
  }

  th {
    background-color: #334155;
  }

  img {
    border-radius: 8px;
  }

  input[type="file"] {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    padding: 10px;
    border-radius: 6px;
    margin-bottom: 10px;
  }

  button {
    background-color: #10b981;
    border: none;
    padding: 10px 15px;
    border-radius: 6px;
    color: white;
    font-weight: bold;
    cursor: pointer;
  }

  button:hover {
    background-color: #059669;
  }

  hr {
    margin: 30px 0;
    border: 1px solid #334155;
  }

  .logout-link {
    display: inline-block;
    margin-top: 20px;
    color: #ef4444;
  }

</style>

<div class="container">

  <h1>Welcome, <%= admin.name %></h1>

  <p><a href="/admin/dashboard">Go to Dashboard</a></p>

  <table>
    <tr>
      <td rowspan="3">
        <img src="/userImages/<%= admin.image %>" width="100" height="100" alt="Admin Image">
      </td>
      <td>Email:</td>
      <td><%= admin.email %></td>
    </tr>
    <tr>
      <td>Mobile:</td>
      <td><%= admin.mobile %></td>
    </tr>
  </table>

  <hr>

  <h2>Upload a File</h2>
  <form action="/admin/upload-file" method="POST" enctype="multipart/form-data">
    <input type="file" name="uploadedFile" required />
    <br>
    <button type="submit">Upload</button>
  </form>

  <hr>

  <h2>Uploaded Files</h2>
  <table>
    <thead>
      <tr>
        <th>File Name</th>
        <th>Type</th>
        <th>Size (KB)</th>
        <th>Uploaded At</th>
        <th>Download</th>
        <th>Delete</th>
      </tr>
    </thead>
    <tbody>
      <% if (files.length === 0) { %>
        <tr>
          <td colspan="6">No files uploaded.</td>
        </tr>
      <% } else { %>
        <% files.forEach(file => { %>
          <tr>
            <td><%= file.originalName %></td>
            <td><%= file.fileType %></td>
            <td><%= (file.size / 1024).toFixed(2) %></td>
            <td><%= file.uploadedAt.toLocaleString() %></td>
            <td><a href="<%= file.path %>" download>Download</a></td>
            <td>
              <form
                action="/admin/delete-file/<%= file._id %>"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this file?');"
              >
                <button type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>

  <a class="logout-link" href="/admin/logout">Logout</a>

</div>

<% include("../layouts/footer.ejs") %>
