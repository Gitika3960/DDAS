<% include('../layouts/header.ejs') %>

<style>
  body {
    background: linear-gradient(to right, #0f172a, #1e3a8a);
    font-family: 'Segoe UI', sans-serif;
    color: #f8fafc;
    margin: 0;
    padding: 0;
  }

  .edit-user-container {
    max-width: 500px;
    margin: 80px auto;
    padding: 30px;
    background-color: #1e293b;
    border-radius: 15px;
    box-shadow: 0 0 20px rgba(0,0,0,0.4);
  }

  h1 {
    text-align: center;
    color: #facc15;
    margin-bottom: 30px;
  }

  input[type="text"],
  input[type="email"],
  input[type="name"],
  input[type="submit"] {
    width: 100%;
    padding: 12px;
    margin: 12px 0;
    border: none;
    border-radius: 8px;
    background-color: #334155;
    color: #f1f5f9;
    font-size: 16px;
  }

  label {
    display: block;
    margin-top: 15px;
    margin-bottom: 5px;
    font-weight: bold;
    color: #f8fafc;
  }

  input[type="radio"] {
    margin-right: 8px;
    margin-top: 10px;
  }

  input[type="submit"] {
    background-color: #10b981;
    font-weight: bold;
    transition: background-color 0.3s;
    cursor: pointer;
  }

  input[type="submit"]:hover {
    background-color: #059669;
  }

  a {
    display: block;
    text-align: center;
    margin-top: 20px;
    color: #38bdf8;
    text-decoration: none;
  }

  a:hover {
    color: #0ea5e9;
  }
</style>

<div class="edit-user-container">
  <h1>Edit User</h1>

  <form action="" method="post">
    <input type="name" name="name" placeholder="Enter Name" value="<%= user.name %>" required>

    <input type="email" name="email" placeholder="Enter Email" value="<%= user.email %>" required>

    <input type="text" name="mno" placeholder="Enter Mobile Number" value="<%= user.mobile %>" required>

    <label>Verification Status:</label>

    <label>
      <input type="radio" name="verify" value="1" <% if(user.is_varified == 1){ %> checked <% } %>> Verified
    </label>

    <label>
      <input type="radio" name="verify" value="0" <% if(user.is_varified == 0){ %> checked <% } %>> Unverified
    </label>

    <input type="hidden" name="id" value="<%= user._id %>">
    <input type="submit" value="Update User">
  </form>

  <a href="/admin/dashboard">⬅ Back to Dashboard</a>
</div>

<% include('../layouts/footer.ejs') %>
